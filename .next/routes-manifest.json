{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/appointments",
      "regex": "^/appointments(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/appointments(?:/)?$"
    },
    {
      "page": "/components",
      "regex": "^/components(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/components(?:/)?$"
    },
    {
      "page": "/components/base",
      "regex": "^/components/base(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/components/base(?:/)?$"
    },
    {
      "page": "/components/livekit",
      "regex": "^/components/livekit(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/components/livekit(?:/)?$"
    },
    {
      "page": "/contact-us",
      "regex": "^/contact\\-us(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact\\-us(?:/)?$"
    },
    {
      "page": "/doctors",
      "regex": "^/doctors(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/doctors(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/opengraph-image-xg4ifa",
      "regex": "^/opengraph\\-image\\-xg4ifa(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/opengraph\\-image\\-xg4ifa(?:/)?$"
    },
    {
      "page": "/services",
      "regex": "^/services(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services(?:/)?$"
    },
    {
      "page": "/treatments",
      "regex": "^/treatments(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/treatments(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}